# Copy this file to .env and fill in your keys.
# .env is read at startup; real environment variables take priority over it.

# ---------------------------------------------------------------- NVIDIA NIM
# Get a key at https://build.nvidia.com - it starts with "nvapi-".
NVIDIA_API_KEY=nvapi-replace-me

# The endpoint. Leave as is unless you are self-hosting a NIM container.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# The model that drives the agent. It MUST support tool calling.
# Run "python main.py models" to see the live catalogue, and "python main.py
# doctor" to confirm your pick really does call tools.
# Good alternatives if this one disappoints:
#   nvidia/nemotron-3.5-lightning-30b-a3b   faster, cheaper
#   nvidia/nemotron-3-ultra-550b-a55b       slower, smarter
#   moonshotai/kimi-k3                      strong at agentic tool use
#   nvidia/llama-3.1-nemotron-70b-instruct  older, dependable
NOVA_MODEL=nvidia/nemotron-3-super-120b-a12b

# The model used for looking at the screen. Must accept image input.
# NIM's vision models cannot call tools, which is why this is separate.
# meta/llama-3.2-90b-vision-instruct reads detail better but can take minutes
# per screenshot on NIM's free tier; 11b answers in seconds.
NOVA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# ------------------------------------------------------------------ tuning
NOVA_TEMPERATURE=0.2
NOVA_MAX_TOKENS=2048

# How many tool-calling rounds before giving up on one instruction.
NOVA_MAX_STEPS=25

# Requests per minute. NVIDIA's free tier allows about 40; staying under
# avoids 429s mid-task.
NOVA_RPM=35

# Seconds before a shell command is killed.
NOVA_SHELL_TIMEOUT=120

# ------------------------------------------------------------------ safety
# Ask before anything that changes the computer: shell commands, writes,
# deletes, clicks, keystrokes. Turning this off lets Nova act unsupervised.
NOVA_CONFIRM_DANGEROUS=true

# Allow mouse and keyboard control.
NOVA_ALLOW_DESKTOP_CONTROL=true

# Where relative paths resolve, and the default working directory.
NOVA_WORKSPACE=C:\Users\User\OneDrive\Documents

# Set true to forbid file tools from touching anything outside the workspace.
NOVA_RESTRICT_TO_WORKSPACE=false

# ----------------------------------------------------------------- discord
# Only needed for "python main.py discord".
# Create an app at https://discord.com/developers/applications, add a Bot,
# turn ON the MESSAGE CONTENT INTENT, then copy the token here.
DISCORD_BOT_TOKEN=

# Your own numeric Discord user ID. Nova ignores everyone else.
# Discord Settings > Advanced > Developer Mode, then right-click your name.
DISCORD_OWNER_ID=

# Optional: restrict Nova to a single channel. 0 or blank means any channel
# it can see (including DMs).
DISCORD_CHANNEL_ID=
